# Endereço público do site (metadados e links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres do Neon: connection string pooled (Console do Neon > Connect). Sensitive na Vercel.
DATABASE_URL=

# Neon Auth: Auth URL do projeto (Console do Neon > Auth)
NEON_AUTH_BASE_URL=
# Segredo para assinar o cookie de sessão, com 32+ caracteres (openssl rand -base64 32). Sensitive na Vercel.
NEON_AUTH_COOKIE_SECRET=

# E-mails que viram admin no primeiro acesso, separados por vírgula
ADMIN_EMAILS=

# Vercel Blob (vídeos das aulas e capas). A Vercel cria sozinha ao conectar um Blob store ao projeto.
# Sem ela, o painel aceita só o endereço do arquivo, sem upload.
BLOB_READ_WRITE_TOKEN=
